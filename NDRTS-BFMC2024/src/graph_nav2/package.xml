<?xml version="1.0"?>
<package format="3">
  <name>graph_nav2</name>
  <version>0.0.1</version>
  <description>Waypoint navigation from GraphML using Nav2</description>
  <maintainer email="ndrts@todo.todo">ndrts</maintainer>
  <license>Apache-2.0</license>

  <!-- build-tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- for srv generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- your regular deps -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>pyproj</depend>
  <depend>networkx</depend>
  <depend>graph_nav2_interfaces</depend> 

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <!-- make the generated Python interfaces available -->
    <build_type>ament_python</build_type>
  </export>
</package>
